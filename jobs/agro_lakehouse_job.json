{
  "name": "agro_lakehouse_diario",
  "description": "Pipeline medallion: llegada del archivo diario de cosecha → bronze (Auto Loader) → silver (MERGE + cuarentena) → gold → validaciones",
  "max_concurrent_runs": 1,
  "parameters": [
    { "name": "catalogo", "default": "workspace" }
  ],
  "git_source": {
    "git_url": "https://github.com/mrenrique/agro-lakehouse-databricks",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "simular_llegada_dia",
      "description": "Simula que llegó el archivo de cosecha del día siguiente",
      "notebook_task": {
        "notebook_path": "notebooks/01_simular_cosecha",
        "source": "GIT",
        "base_parameters": { "modo": "siguiente_dia" }
      }
    },
    {
      "task_key": "bronze_ingesta",
      "depends_on": [{ "task_key": "simular_llegada_dia" }],
      "notebook_task": { "notebook_path": "notebooks/02_bronze_ingesta", "source": "GIT" }
    },
    {
      "task_key": "silver_cosecha",
      "depends_on": [{ "task_key": "bronze_ingesta" }],
      "notebook_task": { "notebook_path": "notebooks/03_silver_cosecha", "source": "GIT" }
    },
    {
      "task_key": "silver_clima",
      "depends_on": [{ "task_key": "bronze_ingesta" }],
      "notebook_task": { "notebook_path": "notebooks/04_silver_clima", "source": "GIT" }
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver_cosecha" }, { "task_key": "silver_clima" }],
      "notebook_task": { "notebook_path": "notebooks/05_gold", "source": "GIT" }
    },
    {
      "task_key": "validaciones",
      "depends_on": [{ "task_key": "gold" }],
      "notebook_task": { "notebook_path": "notebooks/06_validaciones", "source": "GIT" }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 7 * * ?",
    "timezone_id": "America/Lima",
    "pause_status": "PAUSED"
  }
}
